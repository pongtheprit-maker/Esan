  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd02b31fa8126ec48831df891a14c0ae, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SchoolPuzzleObject
  id: floor_plan
  kind: 0
  title: "\u0E1C\u0E31\u0E07\u0E2D\u0E32\u0E04\u0E32\u0E23\u0E40\u0E23\u0E35\u0E22\u0E19"
  text: "\u0E0A\u0E31\u0E49\u0E19 2\n\u0E14\u0E49\u0E32\u0E19\u0E2B\u0E19\u0E49\u0E32:
    \u0E2B\u0E49\u0E2D\u0E07\u0E40\u0E23\u0E35\u0E22\u0E19 2A / 2B\n\u0E15\u0E2D\u0E19\u0E01\u0E25\u0E32\u0E07:
    \u0E2B\u0E49\u0E2D\u0E07\u0E04\u0E23\u0E39\u0E15\u0E30\u0E27\u0E31\u0E19\u0E15\u0E01
    / \u0E15\u0E30\u0E27\u0E31\u0E19\u0E2D\u0E2D\u0E01\n\u0E15\u0E48\u0E2D\u0E44\u0E1B\u0E17\u0E32\u0E07\u0E15\u0E30\u0E27\u0E31\u0E19\u0E15\u0E01:
    Storage\n\u0E14\u0E49\u0E32\u0E19\u0E2B\u0E25\u0E31\u0E07: \u0E2B\u0E49\u0E2D\u0E07\u0E19\u0E49\u0E33\u0E2B\u0E0D\u0E34\u0E07
    / \u0E0A\u0E32\u0E22\n\n\u0E1A\u0E31\u0E19\u0E44\u0E14\u0E2D\u0E22\u0E39\u0E48\u0E14\u0E49\u0E32\u0E19\u0E2B\u0E19\u0E49\u0E32\u0E2D\u0E32\u0E04\u0E32\u0E23\n\u0E25\u0E07\u0E0A\u0E31\u0E49\u0E19
    1 \u0E41\u0E25\u0E49\u0E27\u0E44\u0E1B\u0E17\u0E32\u0E07\u0E15\u0E30\u0E27\u0E31\u0E19\u0E2D\u0E2D\u0E01
    \u0E1C\u0E48\u0E32\u0E19\u0E17\u0E32\u0E07\u0E40\u0E0A\u0E37\u0E48\u0E2D\u0E21\u0E40\u0E02\u0E49\u0E32\u0E42\u0E16\u0E07\u0E15\u0E49\u0E2D\u0E19\u0E23\u0E31\u0E1A\n\u0E0A\u0E31\u0E49\u0E19
    1: \u0E42\u0E16\u0E07\u0E15\u0E49\u0E2D\u0E19\u0E23\u0E31\u0E1A / \u0E2B\u0E49\u0E2D\u0E07\u0E40\u0E23\u0E35\u0E22\u0E19
    102\u2013105, \u0E2B\u0E49\u0E2D\u0E07\u0E2D\u0E38\u0E1B\u0E01\u0E23\u0E13\u0E4C
    106, \u0E2B\u0E49\u0E2D\u0E07\u0E40\u0E23\u0E35\u0E22\u0E19 107\u2013108\n\n\u0E40\u0E2D\u0E01\u0E2A\u0E32\u0E23\u0E15\u0E49\u0E2D\u0E07\u0E40\u0E25\u0E47\u0E07\u0E41\u0E25\u0E49\u0E27\u0E01\u0E14
    E; \u0E23\u0E48\u0E2D\u0E07\u0E23\u0E2D\u0E22\u0E2B\u0E21\u0E36\u0E01\u0E15\u0E49\u0E2D\u0E07\u0E43\u0E0A\u0E49
    UV \u0E01\u0E48\u0E2D\u0E19\u0E15\u0E23\u0E27\u0E08"
